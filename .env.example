# Configuração do servidor Node (SSR/BFF) — src/server.ts e src/server/*.ts.
# Nunca vai para o bundle do browser (diferente de src/environments/environment.ts).
# Copie para .env (gitignored) e preencha com valores reais.

# URL e anon key do projeto Supabase — usados só pelo servidor pra chamar o Supabase Auth
# diretamente (login/signup/logout/reset-password nunca mais rodam no browser).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# URL base da API .NET (api-dashfinras), chamada servidor-a-servidor (sem CORS).
API_DASHFINRAS_URL=http://localhost:5184/api

# Segredo usado pra criptografar o cookie de sessão do front (df_session), que carrega o
# access_token/refresh_token do Supabase. Precisa ter pelo menos 32 caracteres.
SESSION_COOKIE_SECRET=

# Opcional — porta do servidor Node (padrão 4300) e caminhos dos certs HTTPS locais (padrão
# ssl/dev-server.crt e ssl/dev-server.key, os mesmos usados por `npm start`).
# PORT=4300
# SSL_CERT_PATH=ssl/dev-server.crt
# SSL_KEY_PATH=ssl/dev-server.key

# Defina como "true" em produção quando o processo roda atrás de um reverse proxy que termina o
# TLS (ex.: Docker sem certs locais). Isso ativa: confiar no header X-Forwarded-Proto pra saber
# se a conexão original era HTTPS, redirecionar pra https:// quando não for, e header HSTS.
# NÃO defina isso pra rodar local em HTTP puro sem proxy nenhum — o servidor ficaria
# redirecionando pra um https:// que ninguém está escutando.
# BEHIND_PROXY=true
